      ],
      "164": [
        "Spirit Guardians",
        "Level 3 Conjuration (Cleric)",
        "Range: Self",
        "Components: V, S, M (a prayer scroll)",
        "Duration: Concentration, up to 10 minutes",
        "15-foot Emanation",
        "If you are evil, they appear fiendish",
        "you can designate creatures to be unaffected by it",
        "Speed is halved in the Emanation",
        "Emanation enters a creature’s space"
